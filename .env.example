# Bot Environment (dev or prod)
NODE_ENV=prod

# Development Bot Configuration
DEV_BOT_ID=YOUR_DEV_BOT_ID
DEV_CLIENT_SECRET=YOUR_DEV_CLIENT_SECRET
DEV_BOT_TOKEN=YOUR_DEV_BOT_TOKEN
DEV_MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/

# Development Log Webhooks
DEV_ERROR_WEBHOOK=
DEV_GUILD_WEBHOOK=
DEV_COMMAND_WEBHOOK=

# Production Bot Configuration
PROD_BOT_ID=YOUR_PROD_BOT_ID
PROD_CLIENT_SECRET=YOUR_PROD_CLIENT_SECRET
PROD_BOT_TOKEN=YOUR_PROD_BOT_TOKEN
PROD_MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/

# Production Log Webhooks
PROD_ERROR_WEBHOOK=
PROD_GUILD_WEBHOOK=
PROD_COMMAND_WEBHOOK=

# Lavalink status alerts (outages tag all developer IDs)
LAVALINK_WEBHOOK_URL=YOUR_LAVALINK_WEBHOOK_URL

# Links
INVITE_LINK=https://discord.com/oauth2/authorize?client_id=YOUR_BOT_ID&permissions=36988944&scope=bot+applications.commands
SUPPORT_SERVER=https://discord.gg/YOUR_SUPPORT_SERVER

# Top.gg Configuration
TOPGG_TOKEN=YOUR_TOPGG_TOKEN
TOPGG_VOTE_LINK=https://top.gg/bot/YOUR_BOT_ID/vote

# Spotify Configuration
SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID
SPOTIFY_CLIENT_SECRET=YOUR_SPOTIFY_CLIENT_SECRET

# Lavalink Node Configuration
LAVALINK_NODE_NAME=YOUR_LAVALINK_NODE_NAME
LAVALINK_NODE_URL=YOUR_LAVALINK_NODE_URL
LAVALINK_NODE_AUTH=YOUR_LAVALINK_NODE_AUTH
LAVALINK_NODE_SECURE=false

# Bot Settings
BOT_COLOR="#000000"
DEVELOPER_IDS=YOUR_DISCORD_USER_ID
DEV_GUILD_IDS=YOUR_DEV_GUILD_ID

BACKGROUND_URL=YOUR_BACKGROUND_URL

# Max free songs per user per day (voting on top.gg removes the limit)
MAX_SONGS_PER_DAY_LIMIT=10

# Max player session length in hours (0 or invalid falls back to defaults)
# Solo listener (0-1 non-bot members in voice) - default 2
PLAYER_SOLO_MAX_HOURS=2
# 2+ listeners, absolute max for any player - default 3
PLAYER_MULTI_MAX_HOURS=3

# Private stats API for website (Bearer auth, never expose key in browser)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STATS_API_KEY=PASTE_LONG_RANDOM_STRING_HERE
# Localhost only - nginx terminates HTTPS and proxies in
STATS_API_HOST=127.0.0.1
# Port Express listens on inside bot process (localhost). Default 3001.
STATS_API_PORT=3001
